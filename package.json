{
  "name": "satellite-proximity-tracker",
  "version": "1.0.0",
  "description": "Real-time satellite tracking with cyberpunk 3D globe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "author": "ElvijsCoder",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.elvijscoder.sattrack",
    "productName": "SatelliteTracker",
    "win": {
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "SatelliteTracker.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer/**/*",
      "styles/**/*",
      "assets/**/*"
    ]
  }
}
